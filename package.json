{
  "name": "chom",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:site": "node scripts/build.mjs",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@chom/web",
    "dev:mobile": "pnpm --filter @chom/mobile start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "bash scripts/gen-db-types.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  }
}
