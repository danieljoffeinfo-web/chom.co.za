# Public Supabase keys for local apps. Copy to .env.local (web) or .env (Expo).
# After `supabase start`, run `supabase status` and paste the API URL + anon key.

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
