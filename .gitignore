# Environment files hold secrets (API keys, database passwords). Never commit
# them. Commit a .env.example with the variable names and no real values.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules
dist
.next
.turbo
.expo
web-build
*.tsbuildinfo

# Generated by tools on demand
next-env.d.ts

# Local tooling and OS files
.vercel
.DS_Store

# The student dashboard, copied into the web app at build time (originals in static/)
apps/web/public/app/
apps/web/public/teacher/
apps/web/public/shared/
